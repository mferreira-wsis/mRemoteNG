<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Always restore packages from nuget.org, whatever the Visual Studio settings of this machine are -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <config>
    <add key="repositoryPath" value="packages" />
  </config>
</configuration>
